{
    "name": "homeside/laravel-ai-agents",
    "description": "Reusable Laravel AI infrastructure: agent registry, provider resolution, hierarchical prompting, execution recording and module configuration.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "ai",
        "agents",
        "llm",
        "providers"
    ],
    "authors": [
        {
            "name": "HomeSide"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^13.0",
        "laravel/ai": "^1.0",
        "rubix/ml": "^2.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "HomeSide\\AiAgents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HomeSide\\AiAgents\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --config pint.json src config database tests",
        "lint:test": "pint --config pint.json --test src config database tests",
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpstan analyse -c phpstan.neon --no-progress --memory-limit=512M"
        ],
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HomeSide\\AiAgents\\AiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
